# =========================
# Environment
# =========================
ENV=dev

# MongoDB connection for Python app
MONGO_URI=mongodb://NewsBotAI:secret@localhost:27017/newsbotdb?authSource=admin
MONGO_DB=newsbotdb

MIGRATIONS_DIR=./migrations/versions

# Root credentials (used for migrations, indexes, or admin tasks)
MONGO_INITDB_ROOT_USERNAME=NewsBotAI
MONGO_INITDB_ROOT_PASSWORD=secret

# Optional: Mongo Express login for dev convenience (not required for app)
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=admin
MONGO_EXPRESS_PORT=8081

# =========================
# Application Settings
# =========================
DEBUG=True
ENVIRONMENT=development

# API settings
API_V1_PREFIX=/api/v1
PROJECT_NAME=NewsBot AI
VERSION=1.0.0

# Security settings (for future use)
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
